// Build settings shared by every target and configuration.
// Put your own values in Config/Local.xcconfig (gitignored); see Local.xcconfig.example.

// The app defaults to <prefix>.Riff; extensions are nested beneath the app identifier.
RIFF_BUNDLE_PREFIX = dev.riff.placeholder
RIFF_APP_BUNDLE_IDENTIFIER = $(RIFF_BUNDLE_PREFIX).Riff

// The name shown in the Messages app drawer. "Riff" is a code name; change it here only.
RIFF_DISPLAY_NAME = Riff

// Your Apple Developer Team ID. Empty is fine for simulator builds.
DEVELOPMENT_TEAM =

// Keep MARKETING_VERSION equal to RiffCoreInfo.version; a RiffCore test compares them.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
