// Copy to Config/Local.xcconfig and fill in. That file is gitignored, so nothing personal is committed.

// A prefix you own, for example com.yourname
RIFF_BUNDLE_PREFIX = com.example

// Optional: use an existing full app bundle ID instead of <prefix>.Riff.
// RIFF_APP_BUNDLE_IDENTIFIER = com.example.ExistingApp

// The 10-character Team ID from developer.apple.com (Membership details)
DEVELOPMENT_TEAM = ABCDE12345
